# Copy to .env and fill in. Never commit .env.

# Amadeus Travel Builder key. Without it the planner shows demo fares.
AMADEUS_API_KEY=
# AMADEUS_GATEWAY_URL=https://api.amadeus.com

# Force a flight source: demo or amadeus (default: amadeus when the key is set)
# FLIGHT_PROVIDER=

# Server. On Railway, HOST, ALLOWED_HOSTS and DATA_FILE follow from Railway's own variables; set them only elsewhere.
PORT=3000
# HOST=0.0.0.0              # when hosted; then list your public host name(s):
# ALLOWED_HOSTS=pinroute.example.com

# Until sign-in is added: a long random string here makes the address /mcp/<secret>, so only people with the link can connect
# MCP_SECRET=

# Where trips and picks are kept (default: data/store.json)
# DATA_FILE=
