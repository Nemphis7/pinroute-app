# Copy to .env and fill in. Never commit .env. On Railway these go under Variables.

# Amadeus Travel Builder key. Without it the planner shows demo fares.
AMADEUS_API_KEY=
# AMADEUS_GATEWAY_URL=https://api.amadeus.com

# Force a flight source: demo or amadeus (default: amadeus when the key is set)
# FLIGHT_PROVIDER=

# Sign-in (OAuth). The sign-in service's issuer, e.g. https://<name>.authkit.app. Unset: no sign-in.
# AUTH_ISSUER=
# Only for services that don't use the MCP address as the token audience, or hide their keys:
# AUTH_AUDIENCE=
# AUTH_JWKS_URL=
# One time, after switching sign-in on: the first signed-in person takes over the trips saved before
# ADOPT_LOCAL_DATA=true

# The public address. On Railway the generated domain is used until this is set (e.g. your own domain).
# PUBLIC_URL=https://pinroute.example

# Without sign-in only: a long random string here makes the address /mcp/<secret>
# MCP_SECRET=

# Shown on /help and /privacy
# OPERATOR_NAME=
# SUPPORT_EMAIL=
# HOSTING_REGION=the United States
# PRIVACY_UPDATED=22 November 2026

# Limits per person
# SEARCH_LIMIT_PER_DAY=50
# TRIP_LIMIT=200

# Server. On Railway, HOST, ALLOWED_HOSTS and DATA_DIR follow from Railway's own variables; set them only elsewhere.
PORT=3000
# HOST=0.0.0.0              # when hosted; then list your public host name(s):
# ALLOWED_HOSTS=pinroute.example.com
# Folder for pinroute.db (default: data/)
# DATA_DIR=
