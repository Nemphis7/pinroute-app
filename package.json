{
  "name": "pinroute-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pinroute as an MCP App: a trip planner that runs inside Claude, using each traveller's own Claude plan.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/build-ui.mjs",
    "build": "node scripts/build-ui.mjs",
    "start": "node src/server.mjs",
    "dev": "node scripts/build-ui.mjs && node src/server.mjs",
    "test": "node scripts/build-ui.mjs && node --test test/*.test.mjs",
    "stdio": "node src/stdio.mjs",
    "check:amadeus": "node scripts/check-amadeus.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5",
    "esbuild": "0.28.2"
  }
}
